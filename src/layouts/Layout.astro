---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../components/layout.scss";
import {
  author,
  description as siteDescription,
  isProduction,
  profiles,
  title as siteTitle,
} from "../site.mjs";
import manifestSource from "../../static/manifest.webmanifest?raw";

interface Props {
  /** The page's name, shown before the site's in the document title. The front page has none and goes by the site's name alone. */
  title?: string;
  /** What the page offers, in a sentence or two, for search results and link previews. Each page has its own. */
  description: string;
  /** Whether search engines may index the page; the error page may not. A build that is not production is never indexed. */
  indexed?: boolean;
}

const { title, description, indexed = true } = Astro.props;
const isIndexed = isProduction && indexed;
const pageAddress = new URL(Astro.url.pathname, Astro.site);
const documentTitle = title === undefined ? siteTitle : `${title} | ${siteTitle}`;
const manifest: { theme_color: string; icons: { src: string; sizes: string }[] } =
  JSON.parse(manifestSource);
const siteAddress = new URL("/", Astro.site).href;
const icons = manifest.icons.map(({ sizes, src }) => ({
  sizes,
  address: new URL(src, siteAddress),
}));
const iconAddressFor = (sizes: string) => {
  const icon = icons.find((entry) => entry.sizes === sizes);
  if (!icon) throw new Error(`Missing ${sizes} icon in the web manifest`);
  return icon.address.href;
};

const organizationId = new URL("#organization", siteAddress).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: siteTitle,
      url: siteAddress,
      logo: iconAddressFor("512x512"),
      description: siteDescription,
      sameAs: Object.values(profiles),
    },
    {
      "@type": "WebSite",
      "@id": new URL("#website", siteAddress).href,
      name: siteTitle,
      url: siteAddress,
      publisher: { "@id": organizationId },
    },
  ],
};
const jsonSafeInScript = (value: unknown) =>
  JSON.stringify(value).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-space-mono" />
    <Font cssVariable="--font-monoton" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageAddress} />
    <meta property="og:image" content={iconAddressFor("256x256")} />
    <meta name="twitter:creator" content={author} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image:alt" content={siteTitle} />
    <meta name="theme-color" content={manifest.theme_color} />
    {isIndexed ? (
      <link rel="canonical" href={pageAddress} />
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonSafeInScript(structuredData)}
    />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {icons.map(({ address, sizes }) => (
      <link rel="apple-touch-icon" sizes={sizes} href={address.pathname} />
    ))}
  </head>
  <body>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
