---
import Layout from "../layouts/Layout.astro";
import styles from "../styles/about.module.scss";
import { Picture } from "astro:assets";
import ferit from "../images/ferit_bgBlack.png";
import munevver from "../images/munevver_bgBlack.png";
import ifeoluwa from "../images/ifeoluwa_bgBlack.png";
import stanislav from "../images/stanislav_bgBlack.jpg";

const peopleSections = [
  {
    heading: "Founder",
    introduction: "Ferit founded Prove Us Wrong, built it and runs it today.",
    people: [
      {
        name: "Ferit",
        portrait: ferit,
        profile: "https://github.com/0xferit",
        role: "Engineering and research",
      },
    ],
  },
  {
    heading: "Past Contributors",
    introduction: "They worked with Ferit on Prove Us Wrong and have since moved on.",
    people: [
      {
        name: "Münevver",
        portrait: munevver,
        profile: "https://dribbble.com/munevver/",
        role: "Product design",
      },
      {
        name: "Ifeoluwa",
        portrait: ifeoluwa,
        profile: "https://www.linkedin.com/in/iamifeolushola/",
        role: "Community and writing, 2023",
      },
      {
        name: "Stanislav",
        portrait: stanislav,
        profile: "https://github.com/gratestas",
        role: "Engineering on The Truth Post",
      },
    ],
  },
];
---

<Layout
  title="About"
  description="Who we are, what we believe and who has supported us: Prove Us Wrong has worked on decentralized curation since late 2021."
>
  <div>
    <h1> Who We Are </h1>
    <p>
      Prove Us Wrong has worked on decentralized curation since late 2021. We
      built The Truth Post, a news application on Ethereum, and our founder,
      Ferit, wrote the two Decentralized Curation papers. Our story, year by
      year, is <a href="/story/">here</a>.
    </p>

    <h2>What We Believe</h2>
    <p>
      We identify ourselves as cypherpunks and libertarians. We believe that
      this world would be better with more freedom, thus justice, free speech,
      and privacy. We build to create more freedom.
    </p>
    <p>
      We believe that coordinating for the public interest is the biggest
      obstacle to a better world, and that curation is a major source of that
      difficulty. The second part is a hypothesis, and Ferit's framework paper
      states it as one. That is why we work on decentralized curation, and why
      we publish what we build as public goods.
    </p>

    <h2>Support</h2>
    <p>
      <strong>Cooperative Kleros</strong> incubated us in 2022. We joined the
      second cohort of the{" "}
      <a
        href="https://blog.kleros.io/kleros-community-update-june-2022/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Kleros incubator
      </a>{" "}
      with our first project, Prove Me Wrong, and the incubator funded our
      early work.
    </p>
    <p>
      <strong>Golem Foundation</strong> funds our current work.
    </p>
    <p>
      <strong>Octant</strong> sponsored Ferit's{" "}
      <a
        href="https://decentralized-curation.0xferit.workers.dev/"
        target="_blank"
        rel="noopener noreferrer"
      >
        workshop materials
      </a>{" "}
      on the public goods application.
    </p>

    <h2>Disclosure</h2>
    <p>
      Ferit has multi-year engineering experience with Kleros, which The Truth
      Post uses to settle disputes. He holds no Pinakion tokens and has no
      ongoing financial relationship with Kleros.
    </p>

    {peopleSections.map(({ heading, introduction, people }) => (
      <>
        <h2>{heading}</h2>
        <p>{introduction}</p>
        <ul class={styles.people}>
          {people.map(({ name, portrait, profile, role }) => (
            <li>
              <Picture
                src={portrait}
                alt={`${name}'s photo`}
                width={170}
                quality={100}
                formats={["avif", "webp"]}
                densities={[1, 2]}
              />
              <h3><a href={profile} target="_blank" rel="noopener noreferrer">{name}</a></h3>
              <p>{role}</p>
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</Layout>
