{
  "name": "prove-us-wrong",
  "private": true,
  "description": "The website of the organization.",
  "version": "1.0.0",
  "author": "Ferit Tunçer <0xferittuncer@gmail.com>",
  "devDependencies": {
    "parse5": "7.1.2",
    "prettier": "2.8.7"
  },
  "keywords": [
    "ethereum"
  ],
  "scripts": {
    "build": "yarn clean && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "CF_PAGES_BRANCH=develop yarn build",
    "build:production": "CF_PAGES_BRANCH=main yarn build",
    "check:preview": "EXPECTED_BUILD=preview node --test test/*.test.js",
    "check:production": "EXPECTED_BUILD=production node --test test/*.test.js",
    "clean": "rm -rf public .astro node_modules/.astro",
    "develop": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "reference": "node test/write-reference.js",
    "serve": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "start": "yarn develop",
    "test": "yarn build:preview && yarn check:preview && yarn build:production && yarn check:production"
  },
  "prettier": {
    "tabWidth": 2
  },
  "volta": {
    "node": "24.22.2",
    "yarn": "4.10.3"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f",
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "astro": "7.4.7",
    "sass": "1.107.1"
  }
}
